[user]
  name = Anil Oli

[includeIf "hasconfig:remote.*.url:git@bitbucket.org:*/**"]
  path = ~/.gitconfig-bitbucket

[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
  path = ~/.gitconfig-github

[init]
  defaultBranch = main

[merge]
  ff = false

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[commit]
  gpgsign = true

[maintenance]
  repo = ~/dotfiles

[core]
	ignorecase = false
