# ls commands
alias l="ls -a"
alias ll="ls -l"
alias la="ls -la"

# git
alias g="git status"
alias gl="git log"
alias glo="git log --oneline"
alias gpa="git push --all"
alias ga="git add"
alias gaa="git add --a"
alias gc="git commit -m"
alias gca="git commit -am"
alias gd="git diff"
alias gcb="git checkout"
alias gcbn="git checkout -b"
alias gbr="git branch -m"
alias gbd="git branch -d"

# nvim commands
alias nvc="nvim ."
alias vim="nvim"
alias nv="nvim"

